{
  "name": "4105-use-dev-commerce-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:real": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test:firebase": "node tests/integration/run-emulators.mjs",
    "test:integration": "node tests/integration/run-emulators.mjs",
    "test:integration:coverage": "node tests/integration/run-emulators.mjs --coverage",
    "test:coverage:all": "node tests/integration/run-emulators.mjs --all-coverage",
    "test:emulators:prepare": "node tests/integration/prepare-emulators.mjs",
    "emulators:start": "node tests/integration/run-emulators.mjs --start"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.27.0",
    "react-world-flags": "^1.6.0",
    "swiper": "^11.2.10",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.2.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "jsdom": "26.1.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vitest": "3.2.7"
  }
}
